{
	"name": "rubix-cube-solver",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"wasm:build": "wasm-pack build wasm-solver --target web --release --no-pack --out-dir ../src/lib/wasm-solver --out-name rubix_wasm_solver",
		"wasm:test": "cargo test --manifest-path wasm-solver/Cargo.toml --release",
		"wasm:dev": "wasm-pack build wasm-solver --target web --dev --no-pack --out-dir ../src/lib/wasm-solver --out-name rubix_wasm_solver"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/three": "^0.186.0",
		"sass": "^1.105.2",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"wasm-pack": "^0.15.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"three": "^0.186.1"
	}
}
