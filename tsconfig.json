{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		// The only JavaScript in this project is the glue that `wasm-pack`
		// generates into src/lib/wasm-solver, which is not written to satisfy
		// `noImplicitAny`. Its .d.ts is still used for full typing at every call
		// site.
		"checkJs": false
	},
	"include": ["src", "vite.config.ts"],
	"exclude": ["src/lib/wasm-solver"]
}
